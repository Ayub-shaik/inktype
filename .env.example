# Copy to .env (never commit secrets)
INKTYPE_PUBLIC_URL=https://inktype.tomorrowtools.dev
INKTYPE_API_HOST=127.0.0.1
INKTYPE_API_PORT=3041
INKTYPE_COOKIE_SECURE=1

# Defaults to JDI_AUTH_* from llmapp/.env when unset:
# INKTYPE_AUTH_USER=
# INKTYPE_AUTH_PASSWORD=
# INKTYPE_SESSION_SECRET=

# Comma-separated usernames with unlimited admin quotas (optional).
# Without this, signed-in users are free (or Pro after Dodo grant).
# INKTYPE_ADMIN_USERS=you@example.com
# Or set INKTYPE_OWNER_IS_ADMIN=1 for single-user private deploy.

# Channel daemons:
# INKTYPE_INTERNAL_TOKEN=
